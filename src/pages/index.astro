---
// Componentes del Hero y Visuales
import Hero from "@components/sections/hero/Hero.astro"
import Loader from "@components/layout/Loader.astro"

// Componentes del Timeline y Búsqueda
import Navbar from "@components/navbar/Navbar.astro"
import TimelineSection from "@components/sections/timeline/TimelineSection.astro"

// Componente del Equipo
import TeamParticles from "@components/sections/team/TeamParticleBackground.astro"
import TeamCards from "@components/sections/team/TeamCards.astro"

// Componente del Footer
import Footer from "@components/layout/Footer.astro"

// Layout
import Layout from "@layouts/Layout.astro"
---

<Layout title="Siglo XXI">
	<Loader />

	<main class="relative z-20 w-full overflow-x-hidden">
		<section
			id="hero-section"
			class="relative flex min-h-screen w-full items-center justify-center overflow-hidden px-4"
		>
			<Hero />
			<div
				id="cloud-transition"
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 z-20 overflow-hidden opacity-0"
			>
				<div class="absolute -inset-x-1/3 top-[28%] h-[90vh] rounded-[50%] bg-[radial-gradient(ellipse_at_center,rgba(245,245,244,0.62)_0%,rgba(203,213,225,0.36)_28%,rgba(148,163,184,0.12)_54%,transparent_74%)] blur-3xl"></div>
				<div class="absolute -inset-x-1/4 bottom-[-22%] h-[78vh] rounded-[50%] bg-[radial-gradient(ellipse_at_center,rgba(226,232,240,0.48)_0%,rgba(148,163,184,0.18)_42%,transparent_72%)] blur-2xl"></div>
				<div class="absolute inset-x-0 bottom-0 h-2/3 bg-linear-to-t from-stone-100/22 via-slate-200/8 to-transparent"></div>
			</div>

			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-40 bg-linear-to-b from-transparent via-zinc-950/80 to-zinc-950"
			></div>
		</section>

		<Navbar />

		<section
			id="section-timeline"
			class="relative z-30 mt-[-100svh] isolate flex min-h-svh w-full items-center overflow-hidden bg-zinc-950 px-4 py-16 sm:py-20 motion-reduce:mt-0"
		>
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-x-0 top-0 h-36 bg-linear-to-b from-transparent to-[#0d0b12]"
			></div>
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-linear-to-r from-transparent via-cyan-200/30 to-transparent"
			></div>
			<TimelineSection />
		</section>

		<section
			id="section-team"
			class="bg-zinc-950/90 backdrop-blur-lg px-4 py-10"
		>
			<TeamParticles />
			<TeamCards />
			<Footer />
		</section>
	</main>
</Layout>

<script>
	import "@/scripts/landingPage"
</script>
