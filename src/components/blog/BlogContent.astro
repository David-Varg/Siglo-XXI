---
import type { BlogContentProps } from "@/types/blog"

const { description, heroImage, model3d, isRetro }: BlogContentProps = Astro.props
---

<main id="main-content" class="lg:col-span-8">
	<div class="prose prose-invert prose-cyan font-mono relative">
		<section class="flex max-sm:flex-col justify-between items-center mb-12 gap-8 p-6 bg-slate-900/50 rounded-2xl border border-white/5 relative overflow-hidden">
			<div class="absolute inset-0 bg-linear-to-br from-cyan-900/20 to-transparent pointer-events-none"></div>

			<p class="text-xl text-gray-300 font-body relative z-10">
				{description}
			</p>

			<div class="relative w-full aspect-square max-w-sm mx-auto group z-10">
				<div class="absolute -inset-1 bg-linear-to-r from-cyan-500 to-pink-500 rounded-2xl blur opacity-30 group-hover:opacity-75 transition duration-500"></div>

				<div class="relative w-full h-full bg-slate-900 border border-white/10 rounded-2xl overflow-hidden flex items-center justify-center">
					{model3d ? (
						<canvas
							id="hero-three-canvas"
							data-model={model3d}
							data-epoch={isRetro ? "retro" : "modern"}
							class="w-full h-full cursor-grab active:cursor-grabbing"
						></canvas>
					) : (
						<div class="relative w-full h-full">
							<img
								src={`/images/${heroImage}`}
								alt="Visualización del hito"
								class="w-full h-full object-cover rounded-2xl filter brightness-90 contrast-110 group-hover:scale-105 transition-transform duration-500"
							/>
							<div class="absolute inset-0 bg-[linear-gradient(to_right,#00000040_1px,transparent_1px)] bg-size-[mage8px] pointer-events-none"></div>
						</div>
					)}
				</div>
			</div>
		</section>

		<article class="prose-headings:font-title prose-headings:font-bold prose-headings:tracking-tight prose-a:text-cyan-400 prose-blockquote:border-l-cyan-400">
			<slot />
		</article>
	</div>
</main>

{model3d && <script>
	import * as THREE from "three"
	import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js"

	// Me da paja hacerlo aún
</script>}
