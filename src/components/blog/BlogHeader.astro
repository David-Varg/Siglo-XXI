---
import { SearchBar } from "../navbar/SearchBar"
import type { BlogHeaderProps } from "@/types/blog"

const {
	year,
	century,
	place,
	impactScore,
	badgeConfig = { class: "bg-slate-800 border-white/10 text-white" },
}: BlogHeaderProps = Astro.props
---

<header
	id="main-header"
	class="relative w-full mb-12 border border-cyan-500/20 bg-slate-900/40 p-8 max-sm:p-5 rounded-2xl backdrop-blur-md"
>
	<div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-cyan-400"></div>
	<div class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-cyan-400"></div>

	<div class="flex max-sm:flex-col justify-between items-start gap-6">
		<div>
			<div class="type-label mb-2 flex flex-wrap items-center gap-2 text-xs tracking-widest text-cyan-400">
				<span class="inline-block w-2 h-2 bg-emerald-400 rounded-full animate-ping"></span>
				REGISTRO_HISTÓRICO_DESTINO // SIGLO {century}
				<span
					class={`${badgeConfig.class} px-1.5 py-0.5 rounded text-[10px]`}
				>
					[{year < 1950 ? "Fase Análoga" : "Fase Digital"}]
				</span>
			</div>

			<h1 class="type-display mb-4 bg-linear-to-r from-white via-slate-200 to-cyan-300 bg-clip-text text-4xl text-transparent sm:text-5xl">
				<slot />
			</h1>

			<div class="type-label flex flex-wrap gap-3 text-xs text-gray-300">
				<span class="px-2.5 py-1 rounded-md bg-slate-800/80 border border-white/10">
					AÑO: <strong class="text-white">{year}</strong>
				</span>
				<span class="px-2.5 py-1 rounded-md bg-slate-800/80 border border-white/10">
					LUGAR: <strong class="text-white">{place}</strong>
				</span>
				<span
					class={`${badgeConfig.class} px-2.5 py-1 rounded-md text-cyan-300`}
				>
					IMPACTO:{" "}
					<strong class="text-cyan-400">NIVEL {impactScore}</strong>
				</span>
			</div>
		</div>

		<div class="flex flex-col items-end max-sm:items-start gap-4 shrink-0">
			<a
				href="/"
				class="type-label group relative inline-flex items-center gap-2 rounded-xl border border-cyan-500/40 bg-slate-800 px-5 py-2.5 text-xs text-cyan-400 transition-all duration-300 hover:border-cyan-400 hover:bg-cyan-950/80 hover:shadow-[0_0_20px_rgba(6,182,212,0.4)] active:scale-95"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="w-4 h-4 transition-transform group-hover:-translate-x-1"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="2"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M10 19l-7-7m0 0l7-7m-7 7h18"
					/>
				</svg>
				[ ABORTAR_SALTO ]
			</a>

			<SearchBar client:load />
		</div>
	</div>
</header>
