---
import { getCollection } from "astro:content"

const data = await getCollection("team")
---

<section class="min-h-[86vh] mx-auto max-w-7xl text-center lg:py-24 lg:px-6 select-none overflow-hidden rounded-3xl">
	<header
		id="header"
		class="relative z-10 mx-auto mb-12 max-w-screen-sm lg:mb-16"
	>
		<h2 class="font-title mb-4 text-3xl font-extrabold tracking-tight text-white md:text-5xl">
			Equipo Creador
		</h2>
		<p class="font-body text-zinc-400 sm:text-xl">
			Estudiantes encargados del desarrollo, investigación y diseño del
			portal{" "}
			<strong class="block text-zinc-300">"El Siglo XXI"</strong>
		</p>
	</header>

	<div
		id="cards-grid"
		class="relative z-10 grid gap-8 lg:gap-12 sm:grid-cols-2 md:grid-cols-4 sm:gap-4"
	>
		{data.map((member) => (
			<article
				id={member.id}
				class="group flex flex-col items-center rounded-2xl border border-zinc-800/80 bg-zinc-900/60 p-6 backdrop-blur-md transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:border-indigo-500/50 hover:shadow-xl hover:shadow-indigo-500/10 sm:px-2 sm:py-4"
			>
				<!-- Clase card-avatar añadida para stagger secundario -->
				<div class="card-avatar relative mb-4">
					<img
						class="grayscale group-hover:filter-none w-28 h-28 lg:w-32 lg:h-32 rounded-full object-cover border-2 border-zinc-700 group-hover:border-indigo-500 transition-all duration-300 shadow-lg"
						src={member.data.avatar}
						alt={`Foto de ${member.data.name}`}
					/>
				</div>

				{member.data.badge && (
					<span class="font-mono mb-2 px-2.5 py-0.5 text-xs font-semibold text-indigo-400 bg-indigo-500/10 rounded-full border border-indigo-500/20">
						{member.data.badge}
					</span>
				)}

				<h3 class="font-title mb-1 text-xl font-bold tracking-tight text-white group-hover:text-indigo-400 transition-colors">
					{member.data.name}
				</h3>
				<p class="font-body mb-6 text-sm font-medium text-zinc-400">
					{member.data.role}
				</p>

				<ul class="flex justify-center space-x-4 mt-auto">
					{member.data.github && member.data.github !== "#" && (
						<li>
							<a
								href={member.data.github}
								target="_blank"
								rel="noopener noreferrer"
								class="text-zinc-400 hover:text-white transition-colors"
								aria-label={`GitHub de ${member.data.name}`}
								title={`Ir al GitHub de ${member.data.name}`}
							>
								<svg
									class="w-5 h-5 fill-current"
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path
										fill-rule="evenodd"
										d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
										clip-rule="evenodd"
									/>
								</svg>
							</a>
						</li>
					)}
					{member.data.twitter && member.data.twitter !== "#" && (
						<li>
							<a
								href={member.data.twitter}
								target="_blank"
								rel="noopener noreferrer"
								class="text-zinc-400 hover:text-white transition-colors"
								aria-label={`X de ${member.data.name}`}
								title={`Ir al Twitter de ${member.data.name}`}
							>
								<svg
									class="w-5 h-5 fill-current"
									viewBox="0 0 1200 1227"
									aria-hidden="true"
								>
									<path
										fill-rule="evenodd"
										d="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z"
									/>
								</svg>
							</a>
						</li>
					)}
					{member.data.threads && member.data.threads !== "#" && (
						<li>
							<a
								href={member.data.threads}
								target="_blank"
								rel="noopener noreferrer"
								class="text-zinc-400 hover:text-white transition-colors"
								aria-label={`Threads de ${member.data.name}`}
								title={`Ir al Threads de ${member.data.name}`}
							>
								<svg
									class="w-5 h-5 fill-current"
									viewBox="0 0 192 192"
									aria-hidden="true"
								>
									<path
										fill-rule="evenodd"
										d="M141.537 88.9883C140.71 88.5919 139.87 88.2104 139.019 87.8451C137.537 60.5382 122.616 44.905 97.5619 44.745C97.4484 44.7443 97.3355 44.7443 97.222 44.7443C82.2364 44.7443 69.7731 51.1409 62.102 62.7807L75.881 72.2328C81.6116 63.5383 90.6052 61.6848 97.2286 61.6848C97.3051 61.6848 97.3819 61.6848 97.4576 61.6855C105.707 61.7381 111.932 64.1366 115.961 68.814C118.893 72.2193 120.854 76.925 121.825 82.8638C114.511 81.6207 106.601 81.2385 98.145 81.7233C74.3247 83.0954 59.0111 96.9879 60.0396 116.292C60.5615 126.084 65.4397 134.508 73.775 140.011C80.8224 144.663 89.899 146.938 99.3323 146.423C111.79 145.74 121.563 140.987 128.381 132.296C133.559 125.696 136.834 117.143 138.28 106.366C144.217 109.949 148.617 114.664 151.047 120.332C155.179 129.967 155.42 145.8 142.501 158.708C131.182 170.016 117.576 174.908 97.0135 175.059C74.2042 174.89 56.9538 167.575 45.7381 153.317C35.2355 139.966 29.8077 120.682 29.6052 96C29.8077 71.3178 35.2355 52.0336 45.7381 38.6827C56.9538 24.4249 74.2039 17.11 97.0132 16.9405C119.988 17.1113 137.539 24.4614 149.184 38.788C154.894 45.8136 159.199 54.6488 162.037 64.9503L178.184 60.6422C174.744 47.9622 169.331 37.0357 161.965 27.974C147.036 9.60668 125.202 0.195148 97.0695 0H96.9569C68.8816 0.19447 47.2921 9.6418 32.7883 28.0793C19.8819 44.4864 13.2244 67.3157 13.0007 95.9325L13 96L13.0007 96.0675C13.2244 124.684 19.8819 147.514 32.7883 163.921C47.2921 182.358 68.8816 191.806 96.9569 192H97.0695C122.03 191.827 139.624 185.292 154.118 170.811C173.081 151.866 172.51 128.119 166.26 113.541C161.776 103.087 153.227 94.5962 141.537 88.9883ZM98.4405 129.507C88.0005 130.095 77.1544 125.409 76.6196 115.372C76.2232 107.93 81.9158 99.626 99.0812 98.6368C101.047 98.5234 102.976 98.468 104.871 98.468C111.106 98.468 116.939 99.0737 122.242 100.233C120.264 124.935 108.662 128.946 98.4405 129.507Z"
									/>
								</svg>
							</a>
						</li>
					)}
				</ul>

				<button
					type="button"
					class="font-mono mt-6 rounded-full border border-indigo-400/30 bg-indigo-500/10 px-4 py-2 text-[10px] text-indigo-200 transition-colors hover:bg-indigo-500/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-300"
					data-card-open
					data-name={member.data.name}
					data-role={member.data.role}
					data-badge={member.data.badge}
					data-avatar={member.data.avatar}
					data-github={member.data.github}
					data-twitter={member.data.twitter ?? ""}
					data-threads={member.data.threads ?? ""}
					aria-haspopup="dialog"
				>
					Ver perfil
				</button>
			</article>
		))}
	</div>

	<dialog
		id="team-card-dialog"
		class="m-auto w-[min(92vw,32rem)] rounded-3xl border border-white/15 bg-zinc-950/85 p-0 text-white shadow-2xl backdrop:bg-zinc-950/70 backdrop:backdrop-blur-md"
		aria-labelledby="team-dialog-name"
	>
		<div class="relative overflow-hidden rounded-3xl p-7 sm:p-9">
			<div aria-hidden="true" class="pointer-events-none absolute -right-12 -top-16 size-48 rounded-full bg-indigo-500/20 blur-3xl"></div>
			<button
				type="button"
				class="absolute right-4 top-4 z-10 grid size-10 place-items-center rounded-full border border-white/10 bg-white/5 text-xl text-zinc-300 transition hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-300"
				data-card-close
				aria-label="Cerrar perfil"
			>
				<span aria-hidden="true">×</span>
			</button>
			<div class="relative flex flex-col items-center text-center">
				<img data-dialog-avatar class="mb-5 size-28 rounded-full border-2 border-indigo-300/40 object-cover shadow-[0_0_36px_rgba(99,102,241,0.2)]" alt="" />
				<span data-dialog-badge class="font-mono mb-3 rounded-full border border-indigo-400/20 bg-indigo-500/10 px-3 py-1 text-[10px] text-indigo-200"></span>
				<h3 id="team-dialog-name" data-dialog-name class="font-title text-3xl text-white sm:text-4xl"></h3>
				<p data-dialog-role class="font-body mt-2 text-zinc-300"></p>
				<div class="mt-7 flex flex-wrap justify-center gap-3">
					<a data-dialog-github class="font-mono rounded-full border border-white/10 px-4 py-2 text-[10px] text-zinc-200 transition hover:border-indigo-300/50 hover:text-white" target="_blank" rel="noopener noreferrer">GitHub</a>
					<a data-dialog-twitter class="font-mono rounded-full border border-white/10 px-4 py-2 text-[10px] text-zinc-200 transition hover:border-indigo-300/50 hover:text-white" target="_blank" rel="noopener noreferrer">X</a>
					<a data-dialog-threads class="font-mono rounded-full border border-white/10 px-4 py-2 text-[10px] text-zinc-200 transition hover:border-indigo-300/50 hover:text-white" target="_blank" rel="noopener noreferrer">Threads</a>
				</div>
			</div>
		</div>
	</dialog>
</section>

<script>
	import "@/scripts/cardExpansion"
</script>
