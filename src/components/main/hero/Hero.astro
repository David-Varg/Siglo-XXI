---
import HeroCanvas from "./HeroCanvas.astro"
import { VoyagerInfo } from "./VoyagerInfo.tsx"
---

<div class="relative w-full min-h-screen flex flex-col justify-between overflow-hidden select-none px-4">
	<HeroCanvas />

	<!-- Este fue el anterior Sol (corrijo a mi pasado :D)
	Esto es el "Sol" xd
	<div class="pointer-events-none absolute top-[-5%] right-[8%] z-0 h-96 w-96 rounded-full bg-amber-500/20 blur-[130px] animate-pulse"></div>
	<div class="pointer-events-none absolute top-[6%] right-[14%] z-0 h-44 w-44 rounded-full bg-amber-200/35 blur-2xl"></div> -->

	<!-- Titulo y demás cosas :v -->
	<div id="hero-copy" class="flex flex-col relative z-10 text-center max-w-4xl mx-auto items-center gap-4">
		<div class="type-label mt-8 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-medium text-indigo-400 backdrop-blur-md">
			<span class="w-2 h-2 rounded-full bg-indigo-500 animate-ping motion-reduce:animate-none"></span>
			2000 — 2026 y más allá
		</div>

		<h1 class="type-display underline text-5xl text-transparent bg-clip-text bg-linear-to-tr from-white via-zinc-200 to-zinc-500 drop-shadow-md sm:text-7xl md:text-8xl">
			El Siglo XXI
		</h1>

		<p class="type-body max-w-xl text-sm font-light text-zinc-300 sm:text-base">
			Un viaje a través de las transformaciones, descubrimientos
			científicos, saltos tecnológicos y la exploración del cosmos.
		</p>
	</div>

	<!-- La telegrafía de la Voyager 1 (¿Para cuando conectado a la API? Nah, no es necesario para este proyecto) -->
	<VoyagerInfo client:load />
</div>

