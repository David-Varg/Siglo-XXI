<div id="particles-container" class="absolute inset-0 z-0 pointer-events-none w-full h-full"></div>

<script>
  import { tsParticles } from "@tsparticles/engine"
  import { loadSlim } from "@tsparticles/slim"

  async function initParticles() {
    await loadSlim(tsParticles);
    
    await tsParticles.load({
      id: "particles-container",
      options: {
        fullScreen: { enable: false },
        fpsLimit: 60,
        particles: {
          color: {
            value: ["#818cf8", "#38bdf8", "#a7f3d0"],
          },
          links: {
            color: "#818cf8",
            distance: 140,
            enable: true,
            opacity: 0.25,
            width: 1,
          },
          move: {
            enable: true,
            speed: 0.3,
            direction: "none",
            outModes: {
              default: "bounce",
            },
          },
          number: {
            density: {
              enable: true,
              width: 800,
              height: 800,
            },
            value: 100,
          },
          opacity: {
            value: { min: 0.2, max: 0.6 },
          },
          size: {
            value: { min: 1.5, max: 4 },
          },
        },
        detectRetina: true,
      },
    });
  }

  initParticles();
  document.addEventListener("astro:page-load", initParticles);
</script>