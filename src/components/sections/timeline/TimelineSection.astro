---
// Astro
import { getCollection } from "astro:content"

// Static Components
import TimeMachine from "./TimeMachine.astro"
import { CircularCarousel } from "./CircularCarousel"

const entries = (await getCollection("hitos")).sort(
	(a, b) => a.data.year - b.data.year,
)

const items = entries.map((e) => {
	return {
		src: e.data.heroImage,
		alt: e.data.title,
		title: e.data.title,
		subtitle: e.data.description,
	}
})
---

<section
	id="timeline-console"
	class="timeline-console relative z-10 mx-auto w-full max-w-7xl px-4 py-12 sm:px-8 sm:py-16 mt-8"
>
	<header class="relative z-20 mb-8 flex flex-col items-center gap-6 border-b border-white/10 pb-6 sm:mb-10 sm:flex-row sm:items-center sm:justify-between">
		<div>
			<h2 class="type-heading mb-4 text-center text-3xl text-white sm:text-5xl">
				Siglos de evolución
			</h2>
			<p class="type-label mb-3 flex items-center gap-2 text-center text-[10px] tracking-[0.3em] text-amber-200/70 sm:text-xs">
				<span class="size-1.5 rounded-full max-sm:bg-transparent bg-amber-300 shadow-[0_0_12px_rgba(252,211,77,0.8)] animate-ping"></span>
				ARCHIVO CRONOLÓGICO // TIERRA
			</p>
			<p class="type-body mt-3 max-w-xl text-sm text-zinc-400 sm:text-base">
				Cruza los hitos que transformaron nuestra forma de vivir, crear
				y mirar el universo.
			</p>
		</div>
	</header>

	<article class="relative z-0 flex flex-col gap-40 sm:flex-row">
		<TimeMachine />
		<!--<section>
				<div class="mb-5 flex items-end justify-between gap-4">
					<div>
						<p class="type-label text-[10px] tracking-[0.25em] text-cyan-200/60">
							SELECCIONA UN DESTINO
						</p>
						<h3 class="type-heading mt-2 text-xl text-zinc-100 sm:text-2xl">
							Hitos destacados
						</h3>
					</div>
					<span class="shrink-0 type-label text-xs text-zinc-500 select-none">
						{String(entries.length).padStart(3, "0")} registros
					</span>
				</div>
				
			</section> -->

		<div data-carousel-stage class="relative h-108 w-full sm:h-140">
			<CircularCarousel
				client:visible
				items={items}
				ariaLabel="Hitos de la historia"
				preset="panorama"
				intro="rise"
				cardWidth={220}
				aspectRatio={0.75}
				speed={14}
				captions={true}
				gap={25}
				tilt={-3}
				curve={1}
				perspective={1800}
				autoplay="drift"
				interval={3}
				direction="right"
				momentum={0.6}
				snap
				pauseOnHover
				focusOnClick
				draggable
				parallax={0.3}
				stretch={0.5}
				fadeColor="#000000"
				depthFade={0.55}
				innerShade={0.6}
				cornerRadius={12}
			/>
		</div>
	</article>
</section>
