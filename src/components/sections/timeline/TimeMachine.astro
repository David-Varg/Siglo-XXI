---
---

<aside class="relative flex min-h-64 w-full min-w-0 items-center justify-center overflow-hidden rounded-4xl border border-amber-200/10 bg-[radial-gradient(ellipse_at_50%_55%,rgba(8,145,178,0.12),transparent_52%)] bg-zinc-950/45 px-5 py-8 sm:min-h-80 sm:min-w-sm">
	<div
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 opacity-40 [background-image:linear-gradient(rgba(148,163,184,0.08)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.08)_1px,transparent_1px)] [background-size:36px_36px] [mask-image:linear-gradient(to_bottom,transparent,black_25%,black_75%,transparent)]"
	></div>
	<div
		aria-hidden="true"
		class="pointer-events-none absolute left-1/2 top-1/2 h-28 w-76 -translate-x-1/2 -translate-y-1/2 rotate-[-22deg] rounded-[50%] border border-cyan-200/20"
	></div>
	<div
		aria-hidden="true"
		class="pointer-events-none absolute left-1/2 top-1/2 h-22 w-60 -translate-x-1/2 -translate-y-1/2 rotate-[24deg] rounded-[50%] border border-cyan-200/20"
	></div>
	<div
		class="time-machine animate-capsule-idle relative z-10 grid size-44 place-items-center sm:size-56"
		role="img"
		aria-label="Cápsula del tiempo"
	>
		<div class="absolute inset-1 animate-ring-spin rounded-full border border-dashed border-cyan-200/45 motion-reduce:animate-none"></div>
		<div class="absolute inset-5 animate-[ring-spin_12s_linear_infinite_reverse] rounded-full border-2 border-amber-100/65 shadow-[0_0_28px_rgba(251,191,36,0.28)] motion-reduce:animate-none"></div>
		<div class="relative grid size-28 animate-core-pulse place-items-center rounded-full border border-cyan-100/40 bg-[radial-gradient(circle_at_35%_30%,rgba(207,250,254,0.7),rgba(8,145,178,0.3)_24%,rgba(9,9,11,0.95)_72%)] shadow-[inset_0_0_28px_rgba(34,211,238,0.45),0_0_36px_rgba(34,211,238,0.25)] motion-reduce:animate-none sm:size-36">
			<span
				class="type-label flex flex-col justify-center items-center rounded-full border border-white/20 bg-zinc-950/65 px-2 py-1 text-[8px] tracking-[0.18em] text-cyan-100 sm:text-[9px]"
				oncopy="return false"
			>
				P.I.T.O
				<span class="text-[5px] text-center">
					Protocolo <br />
					Interdimensional <br />
					Temporal <br />
					Organizado
				</span>
			</span>
		</div>
		<span
			aria-hidden="true"
			class="absolute left-[calc(50%-0.8rem)] top-0.5 h-[0.55rem] w-[1.6rem] border border-amber-200/65 bg-linear-to-r from-cyan-400/15 to-amber-400/35 shadow-[0_0_14px_rgba(34,211,238,0.2)]"
		></span>
		<span
			aria-hidden="true"
			class="absolute bottom-0.5 left-[calc(50%-0.8rem)] h-[0.55rem] w-[1.6rem] border border-amber-200/65 bg-linear-to-r from-cyan-400/15 to-amber-400/35 shadow-[0_0_14px_rgba(34,211,238,0.2)]"
		></span>
		<span
			aria-hidden="true"
			class="absolute left-0.5 top-[calc(50%-0.275rem)] h-[0.55rem] w-[1.6rem] rotate-90 border border-amber-200/65 bg-linear-to-r from-cyan-400/15 to-amber-400/35 shadow-[0_0_14px_rgba(34,211,238,0.2)]"
		></span>
		<span
			aria-hidden="true"
			class="absolute right-0.5 top-[calc(50%-0.275rem)] h-[0.55rem] w-[1.6rem] rotate-90 border border-amber-200/65 bg-linear-to-r from-cyan-400/15 to-amber-400/35 shadow-[0_0_14px_rgba(34,211,238,0.2)]"
		></span>
	</div>
	<div class="type-label absolute bottom-5 left-5 right-5 flex items-center justify-between gap-3 text-[9px] tracking-[0.2em] text-zinc-500 sm:text-[10px]">
		<span class="select-none">Máquina del tiempo</span>
		<span class="text-amber-100/70 select-none">Lista</span>
	</div>
</aside>
